# NULLSPREAD Research & Sales Academy Environment Configuration

# YouTube Data API v3 (Required for official YouTube search provider)
YOUTUBE_API_KEY=

# OpenRouter API Key (Supports DeepSeek v4.1-flash, v3.2, Claude, OpenAI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Google Gemini API Key (Optional fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Active LLM Provider: auto / openrouter / gemini / mock
LLM_PROVIDER=auto

# Optional: Groq / Whisper Fallback Provider for Audio Transcription
GROQ_API_KEY=

# Environment Mode: development / production / demo
ENVIRONMENT=development

# Database path (default: data/research_academy.db)
DATABASE_PATH=data/research_academy.db

# Provider selection: youtube_api (default) or yt_dlp
YOUTUBE_PROVIDER=youtube_api

